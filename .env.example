DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_tracker?schema=public"
# Optional, CLI only. Needed by `prisma migrate dev` and
# `prisma migrate diff --from-migrations`, which replay migrations into a
# throwaway database. Not read at runtime.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_shadow"
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ANTHROPIC_API_KEY="sk-ant-..."
AZP_CUSTOMER_NUMBER="your_customer_number"
AZP_API_KEY="your_azpetrol_api_key"
WIALON_API_URL="https://your-wialon-host/wialon/ajax.html"
WIALON_TOKEN="your_wialon_token"
WIALON_RESOURCE_ID="0"
WIALON_FUEL_TEMPLATE_ID="0"
CRON_SECRET="replace-with-random-secret"
FORMS_WEBHOOK_SECRET="replace-with-random-secret"
